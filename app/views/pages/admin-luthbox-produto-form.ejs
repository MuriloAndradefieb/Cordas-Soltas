<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar item Luthbox - Cordas Soltas</title>
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/luthbox-operacao.css">
    <link rel="stylesheet" href="/css/luthbox-admin.css">
</head>
<body class="admin-luthbox-page admin-luthbox-produto-form-page">
    <hr class="top-line">
    <header class="main-header"><img src="/img/LOGO ALTERNATIVA CORDAS SOLTAS SITE.png" width="50" alt="Logo Cordas Soltas" class="logo"></header>
    <div class="app-container">
        <nav class="sidebar-nav" aria-label="Navegação administrativa">
            <ul>
                <li onclick="window.location.href='/adm/cadastro'"><img src="/img/perfil-icon.png" width="10" alt=""> Cadastro</li>
                <li onclick="window.location.href='/adm/ingressos'"><img src="/img/ingressos-icon.png" width="10" alt=""> Ingressos</li>
                <li class="active" onclick="window.location.href='/adm/luthbox'"><img src="/img/luthbox-icon.png" width="10" alt=""> Luthbox</li>
                <li onclick="window.location.href='/adm/luthbox/solicitacoes'"><img src="/img/luthbox-icon.png" width="10" alt=""> Solicitações</li>
                <li onclick="window.location.href='/adm/formularios'"><img src="/img/formulario-icon.png" width="10" alt=""> Formulários</li>
            </ul>
        </nav>
        <main class="content-area">
            <div class="luthbox-admin-content">
                <header class="sub-header"><span class="title">LUTHBOX &gt; EDITAR ITEM</span><span class="luth-admin-subtitle"><%= produto.nome %></span></header>
                <form class="luth-product-edit-page-form" method="post" enctype="multipart/form-data" action="/adm/luthbox/produtos/<%= produto.id %>">
                    <div class="luth-product-edit-page-actions">
                        <a class="luth-admin-button luth-product-cancel" href="/adm/luthbox">Cancelar</a>
                        <button class="luth-admin-button" type="submit">Salvar alterações</button>
                    </div>
                    <section class="luth-product-edit-page-panel" aria-label="Dados do produto">
                        <div class="luth-product-edit-page-image">
                            <label for="luthbox-editar-imagem">Imagem do item</label>
                            <label class="luth-product-image-drop" for="luthbox-editar-imagem">
                                <span id="luthbox-editar-placeholder" <%= produto.imagem_url ? 'hidden' : '' %>>Clique para escolher uma imagem</span>
                                <img id="luthbox-editar-preview" src="<%= produto.imagem_url || '' %>" alt="Prévia de <%= produto.nome %>" <%= produto.imagem_url ? '' : 'hidden' %>>
                            </label>
                            <input class="luth-image-input" id="luthbox-editar-imagem" type="file" name="image_file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif">
                            <small>JPG, PNG, WebP, AVIF ou GIF · até 5 MB.</small>
                            <p class="luth-upload-feedback luth-feedback luth-feedback-error" id="luthbox-image-error" role="alert" hidden></p>
                            <% if (produto.imagem_url) { %><label class="luth-remove-image"><input type="checkbox" name="remover_imagem" value="sim"> Remover imagem atual</label><% } %>
                        </div>
                        <div class="luth-product-edit-page-fields">
                            <h2>Informações do item</h2>
                            <div class="luth-product-edit-page-grid">
                                <label>Nome<input name="nome" maxlength="160" value="<%= produto.nome %>" required></label>
                                <label>Classificação<input name="classificacao" maxlength="80" value="<%= produto.classificacao %>" list="luth-categorias" required></label>
                                <label>Compatibilidade<input name="compatibilidade" maxlength="160" value="<%= produto.compatibilidade %>" required></label>
                                <label>Diária (R$)<input type="number" name="preco" min="0" max="100000" step="0.01" value="<%= produto.preco.toFixed(2) %>" required></label>
                                <label>Unidades disponíveis<input type="number" name="quantidade_disponivel" min="0" max="1000" value="<%= produto.quantidade_disponivel %>" required></label>
                                <label class="luth-product-edit-page-description">Descrição<textarea name="descricao" maxlength="500" rows="5" required><%= produto.descricao %></textarea></label>
                            </div>
                            <datalist id="luth-categorias"><option value="Instrumentos"><option value="Acessórios"><option value="Bateria avulsa"><option value="Áudio"><option value="Kits"></datalist>
                        </div>
                    </section>
                </form>
            </div>
        </main>
    </div>
    <script>
        const imageInput = document.getElementById('luthbox-editar-imagem');
        imageInput.addEventListener('change', () => {
            const file = imageInput.files && imageInput.files[0];
            if (!file) return;
            if (!file.type.startsWith('image/') || file.size > 5 * 1024 * 1024) {
                imageInput.value = '';
                const aviso = document.getElementById('luthbox-image-error');
                aviso.textContent = 'Selecione uma imagem válida de até 5 MB.';
                aviso.hidden = false;
                return;
            }
            document.getElementById('luthbox-image-error').hidden = true;
            document.getElementById('luthbox-editar-preview').src = URL.createObjectURL(file);
            document.getElementById('luthbox-editar-preview').hidden = false;
            document.getElementById('luthbox-editar-placeholder').hidden = true;
            const removeCheckbox = document.querySelector('[name="remover_imagem"]');
            if (removeCheckbox) removeCheckbox.checked = false;
        });
    </script>
</body>
</html>
