<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minhas solicitações Luthbox</title>
    <link rel="stylesheet" href="/css/header-nav.css">
    <link rel="stylesheet" href="/css/luthbox-operacao.css">
    <link rel="stylesheet" href="/css/menu-lateral.css">
    <link rel="stylesheet" href="/css/minhas-solicitacoes.css">
</head>
<body class="luth-operacao-page">
    <%- include("../partials/header"); %>
    <%
        // ── Situação de cada pedido ──────────────────────────────────────
        const dataBR = iso => iso ? new Date(`${iso}T12:00:00`).toLocaleDateString('pt-BR') : '';
        const brl = valor => 'R$ ' + Number(valor || 0).toFixed(2).replace('.', ',');
        const ETAPAS = ['Pagamento', 'Aprovação', 'Retirada', 'Devolução'];
        // Pode ser paga em /pagamento?luthbox=ID (mesma regra do servidor)
        const podePagar = s => ['pendente', 'nao_pago'].includes(s.pagamento_status) && s.status !== 'recusada';
        // Em andamento: ainda pede alguma ação (pagar, aguardar, retirar, devolver)
        const emAndamento = s => ['pendente', 'aprovada', 'retirada'].includes(s.status) || s.pagamento_status === 'nao_pago';
        // etapa: posição nas etapas (null = sem etapas); filtro: chave do filtro por etapa
        function situacao(s) {
            if (s.pagamento_status === 'nao_pago') return { rotulo: 'Pagamento em atraso', tom: 'erro', etapa: 0, alerta: true, filtro: 'pagamento' };
            if (s.status === 'recusada') return { rotulo: 'Recusada', tom: 'erro', etapa: null, filtro: 'concluido' };
            if (s.status === 'cancelada') return { rotulo: 'Cancelada', tom: 'erro', etapa: null, filtro: 'concluido' };
            if (s.status === 'devolvida') return { rotulo: 'Concluída', tom: 'info', etapa: 4, filtro: 'concluido' };
            if (s.status === 'retirada') return { rotulo: 'Com você', tom: 'ok', etapa: 3, filtro: 'devolucao' };
            if (s.status === 'aprovada') return { rotulo: 'Pronta para retirada', tom: 'ok', etapa: 2, filtro: 'retirada' };
            if (s.pagamento_status === 'pago') return { rotulo: 'Aguardando aprovação', tom: 'espera', etapa: 1, filtro: 'aprovacao' };
            if (s.pagamento_status === 'informado') return { rotulo: 'Conferindo pagamento', tom: 'espera', etapa: 0, filtro: 'pagamento' };
            return { rotulo: 'Aguardando pagamento', tom: 'pendente', etapa: 0, filtro: 'pagamento' };
        }
        // Opções do filtro por etapa (sem números, só o nome da etapa)
        const FILTROS = [
            { chave: 'pagamento', rotulo: 'Pagamento' },
            { chave: 'aprovacao', rotulo: 'Aprovação' },
            { chave: 'retirada', rotulo: 'Retirada' },
            { chave: 'devolucao', rotulo: 'Devolução' },
            { chave: 'concluido', rotulo: 'Concluídos' }
        ];
        const existeEtapa = chave => solicitacoes.some(s => situacao(s).filtro === chave);
        const ativas = solicitacoes.filter(emAndamento);
        const historico = solicitacoes.filter(s => !emAndamento(s));
        const historicoRemovivel = solicitacoes.filter(item => !['nao_pago','informado'].includes(item.pagamento_status) && (['recusada','cancelada'].includes(item.status) || (item.status === 'devolvida' && item.pagamento_status === 'pago'))).length;
    %>
    <% function itensDoPedido(s) { %>
        <ul class="minha-sol-itens" aria-label="Itens: <%= s.show_titulo %>">
            <% s.itens.forEach(item => { %>
                <li class="minha-sol-item">
                    <span class="minha-sol-foto">
                        <img src="/luthbox/produtos/<%= item.produto_id %>/imagem" alt="Foto de <%= item.nome_item %>" loading="lazy" width="160" height="120">
                        <span class="minha-sol-qtd"><%= item.quantidade %>&times;</span>
                    </span>
                    <strong><%= item.nome_item %></strong>
                    <small><%= brl(Number(item.preco_unitario) * Number(item.quantidade)) %></small>
                </li>
            <% }); %>
        </ul>
    <% } %>
    <% function acaoDoPedido(s, sit) { %>
        <div class="minha-sol-acao minha-sol-acao-<%= sit.tom %>">
            <% if (sit.alerta) { %>
                <p><strong>O prazo de pagamento venceu.</strong> Novas solicitações ficam bloqueadas até a quitação.</p>
            <% } else if (s.status === 'recusada') { %>
                <p>A administração recusou esta solicitação.</p>
            <% } else if (s.status === 'cancelada') { %>
                <p>Solicitação cancelada.</p>
            <% } else if (s.status === 'devolvida') { %>
                <p>Itens devolvidos. Locação concluída.</p>
            <% } else if (s.status === 'retirada') { %>
                <p>Itens retirados. Devolva até <strong><%= dataBR(s.devolucao_ate) %></strong>.</p>
                <% if (s.codigo_retirada) { %><span class="minha-sol-codigo-mini">Código <strong><%= s.codigo_retirada %></strong></span><% } %>
            <% } else if (s.status === 'aprovada' && s.codigo_retirada) { %>
                <div class="minha-sol-codigo" aria-label="Código de retirada">
                    <span>Código de retirada</span>
                    <strong><%= s.codigo_retirada %></strong>
                    <small>Apresente este código para retirar os itens.</small>
                </div>
            <% } else if (s.status === 'aprovada') { %>
                <p>Aprovada. O código de retirada aparece aqui em instantes.</p>
            <% } else if (s.pagamento_status === 'pago') { %>
                <p>Pagamento confirmado. Assim que a administração aprovar, o código de retirada aparece aqui.</p>
            <% } else if (s.pagamento_status === 'informado') { %>
                <p>Você avisou que pagou. A administração está conferindo o recebimento.</p>
            <% } else { %>
                <p><% if (s.pagamento_prazo_iso) { %>Pague até <strong><%= dataBR(s.pagamento_prazo_iso) %></strong> para enviar o pedido à aprovação.<% } else { %>Pague para enviar o pedido à aprovação.<% } %></p>
            <% } %>
            <% if (podePagar(s)) { %><a class="minha-sol-botao" href="/pagamento?luthbox=<%= s.id %>">Pagar agora <span aria-hidden="true">&rarr;</span></a><% } %>
        </div>
    <% } %>
    <% function etapasDoPedido(s, sit) { %>
        <ol class="minha-sol-etapas" aria-label="Andamento: <%= s.show_titulo %>">
            <% ETAPAS.forEach((etapa, i) => { const estado = i < sit.etapa ? 'feita' : i === sit.etapa ? (sit.alerta ? 'alerta' : 'atual') : 'futura'; %>
                <li class="etapa-<%= estado %>"<%- i === sit.etapa ? ' aria-current="step"' : '' %>><span class="minha-sol-etapa-ponto" aria-hidden="true"></span><span class="minha-sol-etapa-nome"><%= etapa %></span><span class="minha-sol-oculto"><%= estado === 'feita' ? ' (concluída)' : estado === 'alerta' ? ' (em atraso)' : estado === 'atual' ? ' (etapa atual)' : '' %></span></li>
            <% }); %>
        </ol>
    <% } %>
    <% function cabecalhoDoPedido(s, sit, Titulo) { %>
        <div class="minha-sol-show">
            <span class="minha-sol-pedido"><%= s.modalidade === 'imediata' ? 'Imediata' : 'Agendada' %></span>
            <<%= Titulo %> class="minha-sol-titulo" id="sol-titulo-<%= s.id %>"><%= s.show_titulo %></<%= Titulo %>>
            <span class="minha-sol-data"><%= dataBR(s.data_evento_iso) %> &middot; <%= s.show_local %><% if (sit.etapa !== null && sit.etapa < 4 && !sit.alerta) { %> &middot; devolu&ccedil;&atilde;o at&eacute; <%= dataBR(s.devolucao_ate) %><% } %></span>
        </div>
        <div class="minha-sol-valor">
            <span class="minha-sol-status tom-<%= sit.tom %>"><%= sit.rotulo %></span>
            <strong><%= brl(s.total) %></strong>
        </div>
    <% } %>
    <main class="luth-operacao-main luth-minhas">
        <a class="luth-voltar" href="/luthbox-seguros">&larr; Voltar ao catálogo</a>
        <header class="luth-operacao-header minhas-topo">
            <div>
                <p class="luth-kicker">Área do artista</p>
                <h1>Minhas solicitações</h1>
            </div>
            <a class="minhas-nova" href="/luthbox-seguros">+ Nova solicitação</a>
        </header>
        <% if (erro) { %><p class="luth-feedback luth-feedback-error" role="alert"><%= erro %></p><% } %>
        <% if (enviada) { %><p class="luth-feedback luth-feedback-success" role="status">Solicitação registrada. Pague a diária para enviar o pedido à aprovação.</p><% } %>
        <% if (Number.isInteger(limpeza)) { %><p class="luth-feedback luth-feedback-success" role="status"><%= limpeza ? `${limpeza} solicitação(ões) concluída(s) removida(s) do histórico.` : 'Não havia solicitações concluídas para remover.' %></p><% } %>
        <% if (possuiDivida) { %>
            <aside class="luth-debt-alert" role="alert"><strong>Pagamento aguardando conferência ou em atraso</strong><p>Novas solicitações ficam pausadas até o pagamento ser confirmado. Use “Pagar agora” no pedido em atraso para quitar.</p></aside>
        <% } %>

        <% if (solicitacoes.length === 0) { %>
            <section class="luth-empty-state"><h2>Nenhuma solicitação ainda</h2><p>Escolha os itens no catálogo para solicitar uma locação.</p><a class="luth-primary-link" href="/luthbox-seguros">Abrir catálogo</a></section>
        <% } else { %>
            <%# Filtro por etapa: mesma estrutura dos filtros do admin (campo recolhido, "Limpar"
                e resumo), com o visual desta página (cartão escuro, rótulo dourado, pílulas) %>
            <div class="minhas-filtro" role="group" aria-label="Filtrar pedidos" data-filtro-etapas>
                <div class="minhas-filtro-campo">
                    <div class="minhas-filtro-cabeca">
                        <label for="filtro-etapa">Etapa do pedido</label>
                        <span class="minhas-filtro-resumo" data-filtro-resumo aria-live="polite"><%= solicitacoes.length %> pedido<%= solicitacoes.length === 1 ? '' : 's' %></span>
                    </div>
                    <select id="filtro-etapa" autocomplete="off">
                        <option value="" selected>Todas as etapas</option>
                        <% FILTROS.forEach(f => { %><option value="<%= f.chave %>"<%= existeEtapa(f.chave) ? '' : ' disabled' %>><%= f.rotulo %></option><% }); %>
                    </select>
                </div>
                <button type="button" class="minhas-filtro-limpar" data-filtro-limpar disabled>Limpar filtro</button>
            </div>
            <p class="minhas-vazio" data-filtro-vazio hidden>Nenhum pedido nesta etapa.</p>

            <section class="minhas-secao" aria-labelledby="minhas-andamento">
                <h2 class="minhas-secao-titulo" id="minhas-andamento">Em andamento <span data-contagem><%= ativas.length %></span></h2>
                <% if (ativas.length === 0) { %>
                    <p class="minhas-vazio">Nenhum pedido em andamento. <a href="/luthbox-seguros">Fazer uma nova solicitação</a></p>
                <% } %>
                <div class="minhas-lista">
                    <% ativas.forEach(s => { const sit = situacao(s); %>
                        <article class="minha-sol minha-sol-<%= sit.tom %>" data-etapa="<%= sit.filtro %>" aria-labelledby="sol-titulo-<%= s.id %>">
                            <header class="minha-sol-topo"><% cabecalhoDoPedido(s, sit, 'h3'); %></header>
                            <% etapasDoPedido(s, sit); %>
                            <% itensDoPedido(s); %>
                            <% acaoDoPedido(s, sit); %>
                        </article>
                    <% }); %>
                </div>
            </section>

            <% if (historico.length) { %>
                <section class="minhas-secao" aria-labelledby="minhas-historico">
                    <div class="minhas-secao-cabecalho">
                        <h2 class="minhas-secao-titulo" id="minhas-historico">Histórico <span data-contagem><%= historico.length %></span></h2>
                        <% if (historicoRemovivel) { %>
                            <form method="post" action="/luthbox/solicitacoes/historico" data-clear-history><button class="luth-secondary-button" type="submit">Limpar histórico concluído</button></form>
                        <% } %>
                    </div>
                    <div class="minhas-lista">
                        <% historico.forEach(s => { const sit = situacao(s); %>
                            <details class="minha-sol minha-sol-compacta minha-sol-<%= sit.tom %>" data-etapa="<%= sit.filtro %>">
                                <summary class="minha-sol-topo">
                                    <span class="minha-sol-miniaturas" aria-hidden="true"><% s.itens.slice(0, 3).forEach(item => { %><img src="/luthbox/produtos/<%= item.produto_id %>/imagem" alt="" loading="lazy" width="40" height="40"><% }); %></span>
                                    <% cabecalhoDoPedido(s, sit, 'span'); %>
                                </summary>
                                <% itensDoPedido(s); %>
                                <% acaoDoPedido(s, sit); %>
                            </details>
                        <% }); %>
                    </div>
                </section>
            <% } %>
        <% } %>
    </main>
    <dialog class="luth-history-dialog" id="clear-history-dialog"><h2>Limpar histórico?</h2><p>Solicitações concluídas e recusadas serão removidas. Pedidos em andamento e cobranças não pagas serão preservados.</p><div><button type="button" data-history-cancel>Voltar</button><button type="button" class="luth-danger-button" data-history-confirm>Limpar histórico</button></div></dialog>
    <%- include("../partials/menu"); %>
    <script src="/js/script.js"></script>
    <script>
        // Filtro por etapa: mostra só os pedidos da etapa escolhida (e esconde seções vazias).
        // A escolha fica guardada na aba, então continua aplicada ao recarregar a página.
        (() => {
            const barra = document.querySelector('[data-filtro-etapas]');
            if (!barra) return;
            const campo = barra.querySelector('#filtro-etapa');
            const limpar = barra.querySelector('[data-filtro-limpar]');
            const cartoes = [...document.querySelectorAll('.minha-sol[data-etapa]')];
            const secoes = [...document.querySelectorAll('.minhas-secao')];
            const vazio = document.querySelector('[data-filtro-vazio]');
            const resumo = document.querySelector('[data-filtro-resumo]');
            const CHAVE = 'luthMinhasSolicitacoesEtapa';
            const total = cartoes.length;
            const pedidos = n => n + ' pedido' + (n === 1 ? '' : 's');

            function aplicar(etapa) {
                campo.value = etapa;
                let visiveis = 0;
                cartoes.forEach(cartao => {
                    const mostrar = !etapa || cartao.dataset.etapa === etapa;
                    cartao.hidden = !mostrar;
                    if (mostrar) visiveis += 1;
                });
                secoes.forEach(secao => {
                    const quantos = secao.querySelectorAll('.minha-sol[data-etapa]:not([hidden])').length;
                    secao.hidden = Boolean(etapa) && quantos === 0;
                    const contagem = secao.querySelector('[data-contagem]');
                    if (contagem) contagem.textContent = quantos;
                });
                campo.classList.toggle('is-ativo', Boolean(etapa));
                limpar.disabled = !etapa;
                vazio.hidden = visiveis > 0;
                resumo.textContent = etapa ? `Mostrando ${visiveis} de ${pedidos(total)}` : pedidos(total);
                try { sessionStorage.setItem(CHAVE, etapa); } catch (erro) { /* sem armazenamento */ }
            }

            campo.addEventListener('change', () => aplicar(campo.value));
            limpar.addEventListener('click', () => { aplicar(''); campo.focus(); });

            let inicial = '';
            try { inicial = sessionStorage.getItem(CHAVE) || ''; } catch (erro) { /* sem armazenamento */ }
            const opcao = inicial && [...campo.options].find(o => o.value === inicial && !o.disabled);
            aplicar(opcao ? inicial : '');
        })();
    </script>
    <script>
        (() => { const dialog=document.getElementById('clear-history-dialog'); let form=null; document.querySelector('[data-clear-history]')?.addEventListener('submit', event=>{ event.preventDefault(); form=event.currentTarget; dialog.showModal(); }); document.querySelector('[data-history-cancel]')?.addEventListener('click',()=>dialog.close()); document.querySelector('[data-history-confirm]')?.addEventListener('click',()=>{ if(form) form.submit(); }); dialog?.addEventListener('click',event=>{ if(event.target===dialog) dialog.close(); }); })();
    </script>
</body>
</html>
