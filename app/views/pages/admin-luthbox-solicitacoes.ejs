<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitações Luthbox</title>
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/luthbox-operacao.css">
    <link rel="stylesheet" href="/css/luthbox-admin.css">
</head>
<body class="admin-luthbox-page admin-luth-padrao">
    <hr class="top-line">
    <header class="main-header"><img src="/img/LOGO ALTERNATIVA CORDAS SOLTAS SITE.png" width="50" alt="Logo Cordas Soltas" class="logo"></header>
    <div class="app-container">
        <nav class="sidebar-nav" aria-label="Navegação administrativa">
            <ul>
                <li onclick="window.location.href='/adm/cadastro'"><img src="/img/perfil-icon.png" width="10" alt=""> Cadastro</li>
                <li onclick="window.location.href='/adm/ingressos'"><img src="/img/ingressos-icon.png" width="10" alt=""> Ingressos</li>
                <li onclick="window.location.href='/adm/luthbox'"><img src="/img/luthbox-icon.png" width="10" alt=""> Luthbox</li>
                <li onclick="window.location.href='/adm/escala'"><img src="/img/luthbox-icon.png" width="10" alt=""> Escala</li>
                <li class="active" onclick="window.location.href='/adm/luthbox/solicitacoes'"><img src="/img/luthbox-icon.png" width="10" alt=""> Solicitações</li>
                <li onclick="window.location.href='/adm/formularios'"><img src="/img/formulario-icon.png" width="10" alt=""> Formulários</li>
            </ul>
        </nav>
        <main class="content-area">
            <% const historicoRemovivel = solicitacoes.filter(item => !['nao_pago','informado'].includes(item.pagamento_status) && (['recusada','cancelada'].includes(item.status) || (item.status === 'devolvida' && item.pagamento_status === 'pago'))).length; %>
            <header class="sub-header">
                <span class="title">SOLICITAÇÕES</span>
                <% if (historicoRemovivel) { %>
                    <form method="post" action="/adm/luthbox/solicitacoes/historico" data-clear-history>
                        <button class="btn-add" type="submit" title="<%= historicoRemovivel %> <%= historicoRemovivel === 1 ? 'solicitação concluída pode ser removida' : 'solicitações concluídas podem ser removidas' %>"><span aria-hidden="true">×</span> Limpar histórico concluído</button>
                    </form>
                <% } %>
            </header>

            <% if (erro) { %><p class="luth-feedback luth-feedback-error" role="alert"><%= erro %></p><% } %>
            <% if (sucesso) { %><p class="luth-feedback luth-feedback-success" role="status"><%= sucesso %></p><% } %>
            <% if (Number.isInteger(limpeza)) { %><p class="luth-feedback luth-feedback-success" role="status"><%= limpeza ? `${limpeza} solicitação(ões) concluída(s) removida(s) do histórico.` : 'Não havia solicitações concluídas para remover.' %></p><% } %>

            <p class="luth-admin-help">Abra um pedido para conferir os itens e executar ações. Agendamentos devem ser pagos em até três dias corridos após o pedido, limitado à data do show. Após conferir o recebimento, confirme o pagamento para liberar a aprovação.</p>

            <%
                /* Chave do filtro "Status do pedido": a mesma regra do selo .luth-status abaixo. */
                const chaveStatus = (s) => s.status === 'pendente' ? (s.pagamento_status === 'pago' ? 'aguardando-aprovacao' : 'aguardando-pagamento') : s.status;
                const filtrosStatus = [
                    { valor: 'aguardando-aprovacao', rotulo: 'Aguardando aprovação' },
                    { valor: 'aguardando-pagamento', rotulo: 'Aguardando pagamento' },
                    { valor: 'aprovada', rotulo: 'Aprovada' },
                    { valor: 'retirada', rotulo: 'Retirada' },
                    { valor: 'devolvida', rotulo: 'Devolvida' },
                    { valor: 'recusada', rotulo: 'Recusada' },
                    { valor: 'cancelada', rotulo: 'Cancelada' }
                ];
                /* Chave do filtro "Pagamento": a mesma regra do selo .luth-payment-badge (o que precisa de ação vem primeiro). */
                const filtrosPagamento = [
                    { valor: 'informado', rotulo: 'Conferir pagamento' },
                    { valor: 'pendente', rotulo: 'Pagamento pendente' },
                    { valor: 'pago', rotulo: 'Pagamento confirmado' },
                    { valor: 'nao_pago', rotulo: 'Não pago · bloqueado' }
                ];
                /* Opção sem nenhum pedido fica desabilitada (cinza), como as opções indisponíveis da Escala. */
                const gruposFiltro = [
                    { grupo: 'status', titulo: 'Status do pedido', todos: 'Todos os status', opcoes: filtrosStatus, existe: (valor) => solicitacoes.some(s => chaveStatus(s) === valor) },
                    { grupo: 'pagamento', titulo: 'Pagamento', todos: 'Todos os pagamentos', opcoes: filtrosPagamento, existe: (valor) => solicitacoes.some(s => s.pagamento_status === valor) }
                ];
            %>
            <% if (solicitacoes.length > 0) { %>
            <div class="luth-scale-form luth-filter-form luth-admin-painel" data-luth-filtros role="group" aria-label="Filtrar solicitações">
                <% gruposFiltro.forEach(grupo => { %>
                    <div class="luth-scale-field">
                        <div class="luth-scale-field-head">
                            <label for="luth-filtro-<%= grupo.grupo %>"><%= grupo.titulo %></label>
                        </div>
                        <select id="luth-filtro-<%= grupo.grupo %>" data-grupo="<%= grupo.grupo %>" autocomplete="off">
                            <option value="" selected><%= grupo.todos %></option>
                            <% grupo.opcoes.forEach(opcao => { %><option value="<%= opcao.valor %>"<%= grupo.existe(opcao.valor) ? '' : ' disabled' %>><%= opcao.rotulo %></option><% }); %>
                        </select>
                    </div>
                <% }); %>
                <button class="luth-btn-neutro" type="button" data-filtro-limpar disabled>Limpar filtros</button>
            </div>
            <p class="luth-filter-summary" data-filtro-resumo aria-live="polite"><%= solicitacoes.length %> solicitaç<%= solicitacoes.length === 1 ? 'ão' : 'ões' %></p>
            <% } %>
            <% if (solicitacoes.length === 0) { %>
            <section class="table-container luth-pedidos-tabela">
                <p class="admin-form-empty">Ainda não há solicitações.</p>
            </section>
            <% } else { %>
            <section class="table-container luth-pedidos-tabela" aria-label="Solicitações">
                <div class="luth-pedidos-cabecalho" aria-hidden="true"><span>ARTISTA</span><span>SHOW</span><span>STATUS</span><span>PAGAMENTO</span><span>TOTAL</span><span>AÇÕES</span></div>
                <% solicitacoes.forEach(solicitacao => { %>
                    <details class="luth-solicitacao-card luth-request-compact" data-status="<%= chaveStatus(solicitacao) %>" data-pagamento="<%= solicitacao.pagamento_status %>">
                        <summary class="luth-request-summary">
                            <span class="luth-pedido-celula luth-pedido-id"><span class="luth-celula-titulo"><%= solicitacao.nome_banda || solicitacao.username %></span></span>
                            <span class="luth-pedido-celula luth-pedido-show"><span class="luth-celula-titulo"><%= solicitacao.show_titulo %></span><small class="luth-celula-detalhe"><%= new Date(`${solicitacao.data_evento_iso}T12:00:00`).toLocaleDateString('pt-BR') %> · <%= solicitacao.show_local %></small></span>
                            <span class="luth-pedido-celula"><span class="luth-status status-<%= solicitacao.status %>"><%= solicitacao.status === 'pendente' ? (solicitacao.pagamento_status === 'pago' ? 'Aguardando aprovação' : 'Aguardando pagamento') : ({aprovada:'Aprovada', retirada:'Retirada', devolvida:'Devolvida', recusada:'Recusada', cancelada:'Cancelada'})[solicitacao.status] || solicitacao.status %></span></span>
                            <span class="luth-pedido-celula"><span class="luth-payment-badge payment-<%= solicitacao.pagamento_status %>"><%= solicitacao.pagamento_status === 'pago' ? 'Pagamento confirmado' : solicitacao.pagamento_status === 'informado' ? 'Conferir pagamento' : solicitacao.pagamento_status === 'nao_pago' ? 'Não pago · bloqueado' : 'Pagamento pendente' %></span></span>
                            <span class="luth-pedido-celula luth-pedido-total">R$ <%= solicitacao.total.toFixed(2).replace('.', ',') %></span>
                        </summary>
                        <div class="luth-request-details">
                            <p><strong>Conta:</strong> <%= solicitacao.username %> · <strong>Modalidade:</strong> <%= solicitacao.modalidade === 'imediata' ? 'Imediata' : 'Agendada' %></p>
                            <ul class="luth-item-list luth-item-list-fotos"><% solicitacao.itens.forEach(item => { %><li><a class="luth-item-foto" href="/adm/luthbox/produtos/<%= item.produto_id %>/imagem" target="_blank" rel="noopener" title="Abrir a foto de <%= item.nome_item %> em outra aba"><img src="/adm/luthbox/produtos/<%= item.produto_id %>/imagem" alt="Foto de <%= item.nome_item %>" loading="lazy" width="64" height="64"></a><span class="luth-item-info"><strong><%= item.nome_item %></strong><small><%= item.quantidade %> unidade(s) · <%= item.classificacao %> · <%= item.compatibilidade %></small></span><span class="luth-item-preco">R$ <%= (Number(item.preco_unitario) * item.quantidade).toFixed(2).replace('.', ',') %></span></li><% }); %></ul>
                            <p class="luth-payment-state">Pagamento: <strong><%= solicitacao.pagamento_status === 'pago' ? 'Confirmado' : solicitacao.pagamento_status === 'informado' ? 'Artista avisou que pagou — conferir recebimento' : solicitacao.pagamento_status === 'nao_pago' ? 'Não pago — novas solicitações bloqueadas' : 'Aguardando pagamento do artista' %></strong><% if (solicitacao.pagamento_prazo_iso) { %> · prazo até <%= new Date(`${solicitacao.pagamento_prazo_iso}T12:00:00`).toLocaleDateString('pt-BR') %><% } %></p>
                            <% if (solicitacao.codigo_retirada) { %><p class="luth-admin-code">Código de retirada: <strong><%= solicitacao.codigo_retirada %></strong></p><% } %>
                            <% if (solicitacao.status === 'pendente') { %>
                                <% if (solicitacao.pagamento_status === 'pago') { %><form class="luth-admin-actions" method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/aprovar"><button class="luth-admin-button" type="submit">Aprovar e gerar código</button></form><% } else if (solicitacao.pagamento_status === 'informado') { %><form class="luth-admin-actions" method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="pago"><button class="luth-admin-button" type="submit">Conferi o recebimento · confirmar pagamento</button></form><% } else { %><p class="luth-payment-waiting">Aguardando o artista concluir o pagamento. A aprovação fica bloqueada até a confirmação.</p><% } %>
                                <div class="luth-admin-actions"><form method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="recusar"><button class="luth-admin-button luth-danger-button" type="submit">Recusar solicitação</button></form></div>
                            <% } else if (solicitacao.status === 'aprovada') { %>
                                <form class="luth-admin-actions" method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="retirada"><label>Código apresentado pelo artista<input name="codigo_retirada" minlength="8" maxlength="8" pattern="[A-Fa-f0-9]{8}" required autocomplete="off"></label><button class="luth-admin-button" type="submit">Validar código e confirmar retirada</button></form>
                            <% } else if (solicitacao.status === 'retirada') { %>
                                <div class="luth-admin-actions"><form method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="devolucao"><button class="luth-admin-button" type="submit">Registrar devolução</button></form></div>
                            <% } %>
                            <% if (solicitacao.modalidade === 'agendada' && ['pendente','informado'].includes(solicitacao.pagamento_status) && solicitacao.pagamento_prazo_iso && solicitacao.pagamento_prazo_iso < hojeIso && ['pendente','aprovada','retirada','devolvida','cancelada'].includes(solicitacao.status)) { %><form class="luth-admin-actions" method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="nao_pago"><button class="luth-admin-button luth-danger-button" type="submit">Marcar como não pago e bloquear novas solicitações</button></form><% } %>
                            <% if (['aprovada','retirada','devolvida','cancelada'].includes(solicitacao.status) && solicitacao.pagamento_status === 'informado') { %><form class="luth-admin-actions" method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="pago"><button class="luth-admin-button" type="submit">Conferi o recebimento · confirmar pagamento</button></form><% } %>
                        </div>
                    </details>
                <% }); %>
                <p class="admin-form-empty luth-filter-empty" data-filtro-vazio hidden>Nenhuma solicitação corresponde aos filtros selecionados.</p>
            </section>
            <% } %>
        </main>
    </div>
    <dialog class="luth-confirm-dialog" id="clear-history-dialog" aria-labelledby="clear-history-title">
        <h3 id="clear-history-title">Limpar histórico?</h3>
        <p><%= historicoRemovivel === 1 ? '1 solicitação concluída ou recusada será removida.' : `${historicoRemovivel} solicitações concluídas e recusadas serão removidas.` %> Pedidos em andamento e cobranças não pagas serão preservados.</p>
        <section class="modal-botoes">
            <button type="button" class="btn-modal btn-modal-cancelar" data-history-cancel>Voltar</button>
            <button type="button" class="btn-modal btn-modal-excluir" data-history-confirm>Sim, limpar</button>
        </section>
    </dialog>
    <script src="/js/script.js"></script>
    <script>
        (() => { const dialog=document.getElementById('clear-history-dialog'); let form=null; document.querySelector('[data-clear-history]')?.addEventListener('submit', event=>{ event.preventDefault(); form=event.currentTarget; dialog.showModal(); }); document.querySelector('[data-history-cancel]')?.addEventListener('click',()=>dialog.close()); document.querySelector('[data-history-confirm]')?.addEventListener('click',()=>{ if(form) form.submit(); }); dialog?.addEventListener('click',event=>{ if(event.target===dialog) dialog.close(); }); })();
    </script>
    <script>
        /* Filtros por status do pedido (.luth-status) e por pagamento (.luth-payment-badge).
           Cada campo mostra só a opção escolhida e abre as demais ao clicar. "Todos" não filtra e os dois campos se combinam (E).
           A escolha fica guardada na aba, para não se perder quando uma ação recarrega a página. */
        (() => {
            const barra = document.querySelector('[data-luth-filtros]');
            if (!barra) return;
            const cartoes = [...document.querySelectorAll('.luth-solicitacao-card[data-status]')];
            const campos = [...barra.querySelectorAll('select[data-grupo]')];
            const resumo = document.querySelector('[data-filtro-resumo]');
            const limpar = barra.querySelector('[data-filtro-limpar]');
            const vazio = document.querySelector('[data-filtro-vazio]');
            const CHAVE = 'luthAdminSolicitacoesFiltros';
            const plural = (n) => `${n} solicitaç${n === 1 ? 'ão' : 'ões'}`;

            const salvar = () => {
                const dados = {};
                campos.forEach(campo => { dados[campo.dataset.grupo] = campo.value; });
                try { sessionStorage.setItem(CHAVE, JSON.stringify(dados)); } catch (erro) { /* sem armazenamento: o filtro só não é lembrado */ }
            };
            const restaurar = () => {
                let guardado = null;
                try { guardado = JSON.parse(sessionStorage.getItem(CHAVE) || 'null'); } catch (erro) { /* valor inválido: começa sem filtros */ }
                campos.forEach(campo => {
                    const valor = guardado && typeof guardado[campo.dataset.grupo] === 'string' ? guardado[campo.dataset.grupo] : '';
                    const opcao = [...campo.options].find(item => item.value === valor && !item.disabled);
                    campo.value = opcao ? valor : '';
                });
            };
            const aplicar = () => {
                const escolhido = (grupo) => campos.find(campo => campo.dataset.grupo === grupo).value;
                const status = escolhido('status');
                const pagamento = escolhido('pagamento');
                let visiveis = 0;
                cartoes.forEach(cartao => {
                    const passa = (!status || cartao.dataset.status === status) && (!pagamento || cartao.dataset.pagamento === pagamento);
                    cartao.hidden = !passa;
                    if (passa) visiveis++;
                });
                const ativo = Boolean(status || pagamento);
                resumo.textContent = ativo ? `Mostrando ${visiveis} de ${plural(cartoes.length)}` : plural(cartoes.length);
                campos.forEach(campo => campo.classList.toggle('is-ativo', campo.value !== ''));
                limpar.disabled = !ativo;
                if (vazio) vazio.hidden = !(ativo && visiveis === 0);
            };

            campos.forEach(campo => campo.addEventListener('change', () => { salvar(); aplicar(); }));
            limpar.addEventListener('click', () => {
                campos.forEach(campo => { campo.value = ''; });
                salvar(); aplicar();
            });
            restaurar(); aplicar();
        })();
    </script>
</body>
</html>
