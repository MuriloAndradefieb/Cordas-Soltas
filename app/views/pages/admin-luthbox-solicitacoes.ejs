<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitações Luthbox</title>
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/luthbox-operacao.css">
    <link rel="stylesheet" href="/css/luthbox-admin.css">
</head>
<body class="admin-luthbox-page">
    <hr class="top-line">
    <header class="main-header"><img src="/img/LOGO ALTERNATIVA CORDAS SOLTAS SITE.png" width="50" alt="Logo Cordas Soltas" class="logo"></header>
    <div class="app-container">
        <nav class="sidebar-nav" aria-label="Navegação administrativa">
            <ul>
                <li onclick="window.location.href='/adm/cadastro'"><img src="/img/perfil-icon.png" width="10" alt=""> Cadastro</li>
                <li onclick="window.location.href='/adm/ingressos'"><img src="/img/ingressos-icon.png" width="10" alt=""> Ingressos</li>
                <li onclick="window.location.href='/adm/luthbox'"><img src="/img/luthbox-icon.png" width="10" alt=""> Luthbox</li>
                <li class="active" onclick="window.location.href='/adm/luthbox/solicitacoes'"><img src="/img/luthbox-icon.png" width="10" alt=""> Solicitações</li>
                <li onclick="window.location.href='/adm/formularios'"><img src="/img/formulario-icon.png" width="10" alt=""> Formulários</li>
            </ul>
        </nav>
        <main class="content-area">
            <div class="luthbox-admin-content">
                <header class="sub-header"><span class="title">SOLICITAÇÕES LUTHBOX</span><span class="luth-admin-subtitle">Aprovações, retiradas e devoluções</span></header>
                <% if (erro) { %><p class="luth-feedback luth-feedback-error" role="alert"><%= erro %></p><% } %>
                <% if (sucesso) { %><p class="luth-feedback luth-feedback-success" role="status"><%= sucesso %></p><% } %>
                <% if (Number.isInteger(limpeza)) { %><p class="luth-feedback luth-feedback-success" role="status"><%= limpeza ? `${limpeza} solicitação(ões) concluída(s) removida(s) do histórico.` : 'Não havia solicitações concluídas para remover.' %></p><% } %>
                <section class="luth-admin-section luth-admin-requests-section">
                    <h2>Solicitações dos artistas</h2>
                    <p class="luth-admin-help">Abra um pedido para conferir os itens e executar ações. Agendamentos devem ser pagos em até três dias corridos após o pedido, limitado à data do show. Após conferir o recebimento, confirme o pagamento para liberar a aprovação.</p>
                    <% const historicoRemovivel = solicitacoes.filter(item => !['nao_pago','informado'].includes(item.pagamento_status) && (['recusada','cancelada'].includes(item.status) || (item.status === 'devolvida' && item.pagamento_status === 'pago'))).length; %>
                    <% if (historicoRemovivel) { %><div class="luth-history-tools"><span><%= historicoRemovivel %> solicitação(ões) concluída(s) podem ser removidas.</span><form method="post" action="/adm/luthbox/solicitacoes/historico" data-clear-history><button class="luth-secondary-button" type="submit">Limpar histórico concluído</button></form></div><% } %>
                    <% if (solicitacoes.length === 0) { %><p class="luth-empty-state">Ainda não há solicitações.</p><% } %>
                    <div class="luth-solicitacoes-list">
                        <% solicitacoes.forEach(solicitacao => { %>
                            <details class="luth-solicitacao-card luth-request-compact">
                                <summary class="luth-request-summary">
                                    <span class="luth-request-main"><span class="luth-kicker">Pedido #<%= solicitacao.id %> · <%= solicitacao.nome_banda || solicitacao.username %></span><strong><%= solicitacao.show_titulo %></strong><small><%= new Date(`${solicitacao.data_evento_iso}T12:00:00`).toLocaleDateString('pt-BR') %> · <%= solicitacao.show_local %></small></span>
                                    <span class="luth-request-meta"><span class="luth-status status-<%= solicitacao.status %>"><%= solicitacao.status === 'pendente' ? (solicitacao.pagamento_status === 'pago' ? 'Aguardando aprovação' : 'Aguardando pagamento') : ({aprovada:'Aprovada', retirada:'Retirada', devolvida:'Devolvida', recusada:'Recusada', cancelada:'Cancelada'})[solicitacao.status] || solicitacao.status %></span><span class="luth-payment-badge payment-<%= solicitacao.pagamento_status %>"><%= solicitacao.pagamento_status === 'pago' ? 'Pagamento confirmado' : solicitacao.pagamento_status === 'informado' ? 'Conferir pagamento' : solicitacao.pagamento_status === 'nao_pago' ? 'Não pago · bloqueado' : 'Pagamento pendente' %></span><strong>R$ <%= solicitacao.total.toFixed(2).replace('.', ',') %></strong></span>
                                </summary>
                                <div class="luth-request-details">
                                    <p><strong>Conta:</strong> <%= solicitacao.username %> · <strong>Modalidade:</strong> <%= solicitacao.modalidade === 'imediata' ? 'Imediata' : 'Agendada' %></p>
                                    <ul class="luth-item-list"><% solicitacao.itens.forEach(item => { %><li><span><strong><%= item.nome_item %></strong><small><%= item.quantidade %> unidade(s) · <%= item.classificacao %> · <%= item.compatibilidade %></small></span><span>R$ <%= (Number(item.preco_unitario) * item.quantidade).toFixed(2).replace('.', ',') %></span></li><% }); %></ul>
                                    <p class="luth-payment-state">Pagamento: <strong><%= solicitacao.pagamento_status === 'pago' ? 'Confirmado' : solicitacao.pagamento_status === 'informado' ? 'Artista avisou que pagou — conferir recebimento' : solicitacao.pagamento_status === 'nao_pago' ? 'Não pago — novas solicitações bloqueadas' : 'Aguardando pagamento do artista' %></strong><% if (solicitacao.pagamento_prazo_iso) { %> · prazo até <%= new Date(`${solicitacao.pagamento_prazo_iso}T12:00:00`).toLocaleDateString('pt-BR') %><% } %></p>
                                    <% if (solicitacao.codigo_retirada) { %><p class="luth-admin-code">Código de retirada: <strong><%= solicitacao.codigo_retirada %></strong></p><% } %>
                                    <% if (solicitacao.status === 'pendente') { %>
                                        <% if (solicitacao.pagamento_status === 'pago') { %><form class="luth-admin-actions" method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/aprovar"><button class="luth-admin-button" type="submit">Aprovar e gerar código</button></form><% } else if (solicitacao.pagamento_status === 'informado') { %><form class="luth-admin-actions" method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="pago"><button class="luth-admin-button" type="submit">Conferi o recebimento · confirmar pagamento</button></form><% } else { %><p class="luth-payment-waiting">Aguardando o artista concluir o pagamento. A aprovação fica bloqueada até a confirmação.</p><% } %>
                                        <div class="luth-admin-actions"><form method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="recusar"><button class="luth-admin-button luth-danger-button" type="submit">Recusar solicitação</button></form></div>
                                    <% } else if (solicitacao.status === 'aprovada') { %>
                                        <form class="luth-admin-actions" method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="retirada"><label>Código apresentado pelo artista<input name="codigo_retirada" minlength="8" maxlength="8" pattern="[A-Fa-f0-9]{8}" required autocomplete="off"></label><button class="luth-admin-button" type="submit">Validar código e confirmar retirada</button></form>
                                    <% } else if (solicitacao.status === 'retirada') { %>
                                        <div class="luth-admin-actions"><form method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="devolucao"><button class="luth-admin-button" type="submit">Registrar devolução</button></form></div>
                                    <% } %>
                                    <% if (solicitacao.modalidade === 'agendada' && ['pendente','informado'].includes(solicitacao.pagamento_status) && solicitacao.pagamento_prazo_iso && solicitacao.pagamento_prazo_iso < hojeIso && ['pendente','aprovada','retirada','devolvida','cancelada'].includes(solicitacao.status)) { %><form class="luth-admin-actions" method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="nao_pago"><button class="luth-admin-button luth-danger-button" type="submit">Marcar como não pago e bloquear novas solicitações</button></form><% } %>
                                    <% if (['aprovada','retirada','devolvida','cancelada'].includes(solicitacao.status) && solicitacao.pagamento_status === 'informado') { %><form class="luth-admin-actions" method="post" action="/adm/luthbox/solicitacoes/<%= solicitacao.id %>/acao"><input type="hidden" name="acao" value="pago"><button class="luth-admin-button" type="submit">Conferi o recebimento · confirmar pagamento</button></form><% } %>
                                </div>
                            </details>
                        <% }); %>
                    </div>
                </section>
            </div>
        </main>
    </div>
    <dialog class="luth-confirm-dialog" id="clear-history-dialog"><h2>Limpar histórico?</h2><p>Solicitações concluídas e recusadas serão removidas. Pedidos em andamento e cobranças não pagas serão preservados.</p><div><button type="button" class="luth-confirm-cancel" data-history-cancel>Voltar</button><button type="button" class="luth-admin-button luth-danger-button" data-history-confirm>Limpar histórico</button></div></dialog>
    <script src="/js/script.js"></script>
    <script>
        (() => { const dialog=document.getElementById('clear-history-dialog'); let form=null; document.querySelector('[data-clear-history]')?.addEventListener('submit', event=>{ event.preventDefault(); form=event.currentTarget; dialog.showModal(); }); document.querySelector('[data-history-cancel]')?.addEventListener('click',()=>dialog.close()); document.querySelector('[data-history-confirm]')?.addEventListener('click',()=>{ if(form) form.submit(); }); dialog?.addEventListener('click',event=>{ if(event.target===dialog) dialog.close(); }); })();
    </script>
</body>
</html>
