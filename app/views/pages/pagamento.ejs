<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pagamento - Cordas Soltas</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/pagamento.css">
    <link rel="stylesheet" href="/css/pagamento-resumo.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
</head>
<%
    // Pagamento de uma solicitação Luthbox (/pagamento?luthbox=ID); null na compra de ingressos
    const pedidoLuthbox = locals.pedidoLuthbox || null;
    const brl = valor => Number(valor || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    const dataBR = iso => iso ? new Date(`${iso}T12:00:00`).toLocaleDateString('pt-BR') : '';
%>
<body class="checkout-page<%= pedidoLuthbox ? ' checkout-luthbox' : '' %>">
    <%- include("../partials/header"); %>
    <main class="main-content">
        <article class="checkout-container">
            <% if (pedidoLuthbox) { %>
            <a href="/luthbox/solicitacoes" class="back-link">&larr; Ver minhas solicitações Luthbox</a>
            <% } else { %>
            <a href="/" class="back-link">&larr; Voltar para a página inicial</a>
            <% } %>
            <h1>Finalizar Compra</h1>
            <nav class="steps" aria-label="Progresso do pagamento">
                <section class="step-item active" data-step="1"><span class="step-circle">1</span><p>Informações</p></section>
                <section class="step-item" data-step="2"><span class="step-circle">2</span><p>Pagamento</p></section>
                <section class="step-item" data-step="3"><span class="step-circle">3</span><p>Confirmação</p></section>
            </nav>
            <section class="step-content">
                <%# Passo 1: só as informações da compra (sem campos para preencher).
                    Luthbox vem do servidor; ingressos são preenchidos por pagamento.js. %>
                <section class="step-section" id="step-1">
                    <% if (pedidoLuthbox) { %>
                    <section class="summary-box compra" aria-labelledby="compra-titulo">
                        <header class="compra-topo">
                            <h2 class="summary-title" id="compra-titulo">Locação Luthbox · Pedido #<%= pedidoLuthbox.id %></h2>
                            <span class="compra-selo"><%= pedidoLuthbox.modalidade === 'agendada' ? 'Agendamento antecipado' : 'Solicitação imediata' %></span>
                        </header>
                        <p class="compra-show">
                            <strong><%= pedidoLuthbox.show_titulo %></strong>
                            <span><%= dataBR(pedidoLuthbox.data_evento_iso) %><% if (pedidoLuthbox.show_local) { %> · <%= pedidoLuthbox.show_local %><% } %></span>
                        </p>
                        <p class="compra-prazos">
                            <span class="compra-prazo">Devolução até <strong><%= dataBR(pedidoLuthbox.devolucao_ate) %></strong></span>
                            <% if (pedidoLuthbox.pagamento_prazo_iso) { %>
                            <span class="compra-prazo compra-prazo-pagar">Pague até <strong><%= dataBR(pedidoLuthbox.pagamento_prazo_iso) %></strong></span>
                            <% } %>
                        </p>
                        <ul class="compra-itens" aria-label="Itens da locação">
                            <% pedidoLuthbox.itens.forEach(item => { %>
                            <li>
                                <span class="compra-qtd"><%= item.quantidade %><span aria-hidden="true">×</span><span class="compra-oculto"> <%= Number(item.quantidade) === 1 ? 'unidade de' : 'unidades de' %></span></span>
                                <span class="compra-nome"><strong><%= item.nome_item %></strong> <small><%= brl(item.preco_unitario) %> / diária</small></span>
                                <span class="compra-subtotal"><%= brl(Number(item.preco_unitario) * Number(item.quantidade)) %></span>
                            </li>
                            <% }) %>
                        </ul>
                        <p class="compra-total"><span>Total da diária</span><strong><%= brl(pedidoLuthbox.total) %></strong></p>
                    </section>
                    <% } else { %>
                    <section class="summary-box compra" id="compra-ingressos" aria-labelledby="compra-titulo" hidden>
                        <header class="compra-topo">
                            <h2 class="summary-title" id="compra-titulo">Ingressos</h2>
                        </header>
                        <p class="compra-show" id="compra-show" hidden><strong id="compra-show-titulo"></strong></p>
                        <ul class="compra-itens" id="compra-itens" aria-label="Ingressos selecionados"></ul>
                        <p class="compra-total"><span>Total</span><strong id="compra-total"></strong></p>
                    </section>
                    <% } %>
                    <button type="button" class="buy-button" id="next-to-payment">Ir para pagamento</button>
                </section>
                <section class="step-section" id="step-2" style="display:none">
                    <p class="error-message-checkout" id="error-message-step2" style="display:none"></p>
                    <aside class="summary-box" id="order-summary"></aside>
                    <aside class="summary-box"><h3>Pagamento seguro com Mercado Pago</h3><p>Continue para escolher Pix, cartão ou outra forma de pagamento disponível na sua conta Mercado Pago.</p></aside>
                    <form id="payment-form">
                        <div id="wallet_container" style="display:none"></div>
                        <button type="button" class="buy-button" id="back-to-info">Voltar</button>
                        <button type="submit" class="buy-button" id="submit-payment">Ir ao Mercado Pago</button>
                    </form>
                </section>
                <section class="step-section" id="step-3" style="display:none">
                    <h2 id="result-title">Resultado do pagamento</h2>
                    <aside class="summary-box" id="confirmation-details" style="display:none">
                        <% if (pedidoLuthbox) { %>
                        <h3>Obrigado pela sua compra!</h3><p>Seu pagamento foi aprovado. A solicitação agora aguarda a aprovação da administração, que libera o código de retirada.</p>
                        <p class="summary-total">Pedido: <span id="product-title-confirm"></span> — <span id="total-confirm">R$ 0,00</span></p>
                        <a href="/luthbox/solicitacoes" class="buy-button ticket-confirmation-link">Ver minhas solicitações</a>
                        <% } else { %>
                        <h3>Obrigado pela sua compra!</h3><p>Seu pagamento foi aprovado e o pedido foi registrado.</p>
                        <p class="summary-total">Pedido: <span id="product-title-confirm"></span> — <span id="total-confirm">R$ 0,00</span></p>
                        <a href="/meus-ingressos" class="buy-button ticket-confirmation-link">Ver meus ingressos</a>
                        <% } %>
                        <p id="return-countdown" class="return-countdown" role="status" hidden></p>
                    </aside>
                    <aside class="summary-box" id="pending-details" style="display:none"><h3>Pagamento em análise</h3><p id="pending-message">O Mercado Pago ainda está processando este pagamento.</p><% if (pedidoLuthbox) { %><a href="/pagamento?luthbox=<%= pedidoLuthbox.id %>" class="buy-button compra-retry" id="retry-payment" hidden>Tentar pagar novamente</a><% } %></aside>
                    <a href="/" class="buy-button" style="text-decoration:none;display:block;text-align:center">Voltar ao início</a>
                </section>
            </section>
        </article>
    </main>
    <%- include("../partials/menu"); %>
    <script src="/js/script.js"></script>
    <script src="https://sdk.mercadopago.com/js/v2"></script>
    <script>window.MP_PUBLIC_KEY = <%- JSON.stringify(mpPublicKey || '') %>;</script>
    <script>window.PEDIDO_LUTHBOX = <%- JSON.stringify(pedidoLuthbox ? { id: pedidoLuthbox.id, total: pedidoLuthbox.total, title: `Locação Luthbox · Pedido #${pedidoLuthbox.id}` } : null).replace(/</g, '\\u003c') %>;</script>
    <script src="/js/pagamento.js"></script>
</body>
</html>
