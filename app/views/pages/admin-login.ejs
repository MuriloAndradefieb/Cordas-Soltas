<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Acesso administrativo · Cordas Soltas</title>
    <style>
        * { box-sizing:border-box; }
        body { min-height:100vh; margin:0; display:grid; place-items:center; padding:1rem; background:#0b0b0e; color:#f4f4f6; font-family:Inter,Arial,sans-serif; }
        main { width:min(100%,430px); padding:2rem; border:1px solid #35353c; border-radius:18px; background:linear-gradient(145deg,#1b1b21,#121216); box-shadow:0 24px 70px #0008; }
        .brand { margin:0; color:#f5a623; font-size:.78rem; font-weight:800; letter-spacing:.16em; }
        h1 { margin:.55rem 0 .4rem; font-size:1.8rem; }
        .intro { margin:0 0 1.5rem; color:#b8bac2; line-height:1.5; }
        form { display:grid; gap:.8rem; }
        label { display:grid; gap:.4rem; color:#d5d6dc; font-size:.9rem; }
        input { width:100%; min-height:46px; padding:.7rem; border:1px solid #4a4a54; border-radius:9px; background:#0f0f13; color:#fff; font:inherit; }
        button { min-height:46px; margin-top:.35rem; border:0; border-radius:9px; background:#f5a623; color:#171006; font:inherit; font-weight:800; cursor:pointer; }
        .error { margin:0 0 1rem; padding:.8rem; border-radius:9px; background:#4b2020; color:#ffd0d0; }
        a { display:inline-block; margin-top:1.1rem; color:#ffd27a; text-decoration:none; }
        :focus-visible { outline:3px solid #ffd27a; outline-offset:3px; }
    </style>
</head>
<body>
    <main>
        <p class="brand">CORDAS SOLTAS</p>
        <h1>Área administrativa</h1>
        <p class="intro">Entre com a conta de administração autorizada para continuar.</p>
        <% if (erro) { %><p class="error" role="alert">E-mail ou senha inválidos. Confira os dados e tente novamente.</p><% } %>
        <form method="post" action="/adm/entrar">
            <input type="hidden" name="retorno" value="<%= retorno %>">
            <label for="email">E-mail administrativo<input id="email" name="email" type="email" autocomplete="username" required autofocus></label>
            <label for="senha">Senha<input id="senha" name="senha" type="password" autocomplete="current-password" required></label>
            <button type="submit">Entrar na administração</button>
        </form>
        <a href="/">Voltar ao site</a>
    </main>
</body>
</html>
